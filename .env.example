# Modelo de configuração local. Copie para `.env` e preencha.
# O `.env` real nunca é versionado — está no .gitignore e deve continuar lá.
#
# O frontend tem o seu próprio .env.example, em frontend/.

# --- Aplicação ---------------------------------------------------------------
AMBIENTE=local
LOG_NIVEL=INFO
CORS_ORIGENS=["http://localhost:5173"]

# --- Google Cloud (Firestore, BigQuery, Firebase) ----------------------------
# Aceita duas formas: o JSON da service account inline (uma linha só) ou o
# caminho de um arquivo local. O arquivo, se usado, fica FORA do repositório.
GOOGLE_APPLICATION_CREDENTIALS={"type": "service_account", "project_id": "..."}
GCP_PROJETO_ID=plataforma-clara
BIGQUERY_DATASET=dados_fidc

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Groq (LLM do relatório) -------------------------------------------------
GROQ_API_KEY=gsk_...
LLM_MODEL_NAME=groq:openai/gpt-oss-120b
LLM_TEMPERATURE=0.1
