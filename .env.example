# Modelo de configuração local. Copie para `.env` e preencha.
# O `.env` real nunca é versionado — está no .gitignore e deve continuar lá.

# --- PostgreSQL (Railway em nuvem; docker compose local) ---------------------
# Local, com o docker-compose deste repositório:
#   postgresql://clara:clara@localhost:5432/plataforma_clara
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# --- Redis (Railway em nuvem; docker compose local) --------------------------
# Cache e, dependendo da decisão de broker, também a fila de eventos.
REDIS_URL=redis://localhost:6379/0

# --- Google Cloud ------------------------------------------------------------
# Aceita duas formas: o JSON da service account inline (uma linha só) ou o
# caminho de um arquivo local. O arquivo, se usado, fica FORA do repositório.
GOOGLE_APPLICATION_CREDENTIALS={"type": "service_account", "project_id": "..."}

# --- Groq (LLM do relatório) -------------------------------------------------
GROQ_API_KEY=gsk_...
