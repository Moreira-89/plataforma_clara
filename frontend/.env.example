# URL do serviço de backend. Em produção, a URL pública do serviço no Railway.
# Vazio em desenvolvimento: o proxy do Vite atende /api.
VITE_API_URL=

# No Docker e no Railway estas variáveis precisam existir também NO BUILD (são build args do
# frontend/Dockerfile): defina-as nas variáveis do serviço antes de publicar.
# Config web do Firebase (Console > Configurações do projeto > Seus apps > App da Web).
# Não são segredos: vão no bundle. A segurança está nas regras e no backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=plataforma-clara
