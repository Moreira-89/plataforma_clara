# Copie para `.env` e preencha. O `.env` real nunca é versionado.

GOOGLE_APPLICATION_CREDENTIALS={"type": "service_account", "project_id": "..."}
PROJECT_ID=plataforma-clara
BIGQUERY_DATASET=tabelas_silvers
BIGQUERY_DATASET_EMPRESAS=dados_fidc

# Origens que podem chamar a API (separadas por vírgula). Em produção, a URL do frontend.
CORS_ORIGENS=http://localhost:5173

REDIS_URL=redis://localhost:6379/0

GROQ_API_KEY=gsk_...
LLM_MODEL_NAME="groq:openai/gpt-oss-120b"
LLM_TEMPERATURE=0.1
